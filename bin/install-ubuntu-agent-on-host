#!/bin/sh
set -eu

repo_url='https://github.com/Iacob-Alexandru-Andrei/dotfiles.git'
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
setup_ref=$(git -C "$repo_dir" symbolic-ref --quiet --short HEAD 2>/dev/null ||
  git -C "$repo_dir" rev-parse --short HEAD)
personal_key=''
work_key=''
want_personal=-1
want_work=0
with_dotfiles=1
install_apt=1
install_neovim=1
dotfiles_args=''

# The key each account signs with here, so neither has to be typed. An explicit
# --personal-key/--work-key still wins; this is the answer when nothing is given.
default_personal_key="$HOME/.ssh/id_ed25519_github_personal"
default_work_key="$HOME/.ssh/id_ed25519"

usage() {
  cat <<'EOF' >&2
usage: install-ubuntu-agent-on-host [options] <ssh-host>

Options:
  --personal            Install personal GitHub auth (the default when neither is given)
  --work                Install work GitHub auth; pass both flags to install both
  --personal-key PATH   Personal key to copy, overriding the discovered one
  --work-key PATH       Work key to copy, overriding the discovered one
  --skip-dotfiles       Do not run the normal ~/.dotfiles/install.sh on remote
  --skip-apt            Do not install missing Ubuntu packages
  --install-apt         Install missing Ubuntu packages (default; kept for compatibility)
  --skip-neovim         Do not install Neovim/AstroNvim
  --minimal             Pass --minimal to remote install.sh; also skips Ubuntu-agent Neovim
  --no-packages         Pass --no-packages to remote install.sh
  --no-nvim             Pass --no-nvim to remote install.sh; also skips Ubuntu-agent Neovim
  -h, --help            Show this help

This script never commits, prints, or stores private keys in the dotfiles repo.
EOF
}

host=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --personal)
      want_personal=1
      shift
      ;;
    --work)
      want_work=1
      shift
      ;;
    --personal-key)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      personal_key=$2
      want_personal=1
      shift 2
      ;;
    --work-key)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      work_key=$2
      want_work=1
      shift 2
      ;;
    --skip-dotfiles)
      with_dotfiles=0
      shift
      ;;
    --install-apt)
      install_apt=1
      shift
      ;;
    --skip-apt)
      install_apt=0
      shift
      ;;
    --skip-neovim)
      install_neovim=0
      shift
      ;;
    --minimal)
      dotfiles_args="$dotfiles_args --minimal"
      install_neovim=0
      shift
      ;;
    --no-packages)
      dotfiles_args="$dotfiles_args --no-packages"
      shift
      ;;
    --no-nvim)
      dotfiles_args="$dotfiles_args --no-nvim"
      install_neovim=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage
      exit 2
      ;;
    *)
      [ -z "$host" ] || { usage; exit 2; }
      host=$1
      shift
      ;;
  esac
done

[ -n "$host" ] || { usage; exit 2; }

# Each flag selects its own account and nothing else, so `--work` is work, `--personal`
# is personal, and typing both is what installs both. Neither given means personal,
# because that is the account with nothing to opt into.
if [ "$want_personal" -eq -1 ] && [ "$want_work" -eq 0 ]; then
  want_personal=1
fi
[ "$want_personal" -ne -1 ] || want_personal=0

resolve_key() {
  label=$1
  chosen=$2
  fallback=$3

  if [ -n "$chosen" ]; then
    printf '%s\n' "$chosen"
    return 0
  fi
  if [ -f "$fallback" ]; then
    printf '%s\n' "$fallback"
    return 0
  fi
  # Naming the path that was searched beats "key not found": the fix is either to put a
  # key there or to pass the one that exists.
  printf 'no %s key found at %s; pass --%s-key PATH\n' "$label" "$fallback" "$label" >&2
  exit 1
}

if [ "$want_personal" -eq 1 ]; then
  personal_key=$(resolve_key personal "$personal_key" "$default_personal_key")
fi
if [ "$want_work" -eq 1 ]; then
  work_key=$(resolve_key work "$work_key" "$default_work_key")
fi

install_terminfo() {
  term_name=${TERM:-}

  [ -n "$term_name" ] || return 0

  case $term_name in
    *[!A-Za-z0-9._+-]*)
      printf 'skipping terminfo install for unusual TERM: %s\n' "$term_name" >&2
      return 0
      ;;
  esac

  command -v infocmp >/dev/null 2>&1 || return 0
  infocmp -x "$term_name" >/dev/null 2>&1 || return 0

  if ssh "$host" "infocmp '$term_name' >/dev/null 2>&1"; then
    return 0
  fi

  if ! ssh "$host" "command -v tic >/dev/null 2>&1"; then
    printf 'remote host is missing tic; install ncurses terminfo or run tmux with TERM=xterm-256color\n' >&2
    return 0
  fi

  printf 'installing terminfo on %s: %s\n' "$host" "$term_name"
  infocmp -x "$term_name" | ssh "$host" "tic -x -"
}

copy_key_if_requested() {
  label=$1
  source_path=$2
  remote_name=$3

  [ -n "$source_path" ] || return 0
  [ -f "$source_path" ] || {
    printf 'missing %s key: %s\n' "$label" "$source_path" >&2
    exit 1
  }

  printf 'copying %s key to remote ~/.ssh/%s\n' "$label" "$remote_name"
  ssh "$host" "set -eu; umask 077; mkdir -p \"\$HOME/.ssh\""
  scp -q "$source_path" "$host:.ssh/${remote_name}.tmp"
  ssh "$host" "set -eu; chmod 600 \"\$HOME/.ssh/${remote_name}.tmp\"; mv \"\$HOME/.ssh/${remote_name}.tmp\" \"\$HOME/.ssh/${remote_name}\""

  if [ -f "${source_path}.pub" ]; then
    scp -q "${source_path}.pub" "$host:.ssh/${remote_name}.pub.tmp"
    ssh "$host" "set -eu; chmod 644 \"\$HOME/.ssh/${remote_name}.pub.tmp\"; mv \"\$HOME/.ssh/${remote_name}.pub.tmp\" \"\$HOME/.ssh/${remote_name}.pub\""
  fi
}

install_terminfo

# Keys go on FIRST. They are the part of this script that cannot be done by hand later,
# and putting the checkout update ahead of them means any git trouble on the remote --
# a local edit, a diverged branch -- takes the whole install down before a single key is
# copied. A host with keys and a stale checkout is recoverable; the reverse is what
# leaves you unable to clone anything.
copy_key_if_requested "personal GitHub" "$personal_key" "github-personal"
copy_key_if_requested "work GitHub" "$work_key" "github-company"

# `Host github.com` reads ~/.ssh/id_ed25519, so a plain git@github.com URL needs one of
# the two to claim it. Personal takes it whenever personal was selected -- personal is
# always fine, and it is what makes an unqualified clone work. Work only claims it on a
# work-only install, where it is the sole key present.
if [ "$want_personal" -eq 1 ]; then
  copy_key_if_requested "personal GitHub default" "$personal_key" "id_ed25519"
else
  copy_key_if_requested "work GitHub default" "$work_key" "id_ed25519"
fi

# A hand-edit on the remote is someone's work: it is neither discarded nor moved. The run
# stops and says which files and what to do, having already installed the keys above --
# so the account setup survives a checkout this script refuses to touch.
ssh "$host" "set -eu
if [ ! -d \"\$HOME/.dotfiles/.git\" ]; then
  git clone --branch '$setup_ref' '$repo_url' \"\$HOME/.dotfiles\"
else
  # The dirty check comes before `remote set-url` and `fetch`, so a refusal leaves the
  # checkout exactly as it was found -- config included.
  dirty=\$(git -C \"\$HOME/.dotfiles\" status --porcelain)
  if [ -n \"\$dirty\" ]; then
    printf 'refusing to update ~/.dotfiles: local changes are present\n' >&2
    printf '%s\n' \"\$dirty\" >&2
    printf 'SSH keys were installed. To finish the update, on that host either\n' >&2
    printf '  commit:  git -C ~/.dotfiles commit -a\n' >&2
    printf '  keep:    git -C ~/.dotfiles stash push -u\n' >&2
    printf '  discard: git -C ~/.dotfiles checkout -- .\n' >&2
    printf 'then re-run this command.\n' >&2
    exit 1
  fi
  git -C \"\$HOME/.dotfiles\" remote set-url origin '$repo_url'
  git -C \"\$HOME/.dotfiles\" fetch origin '$setup_ref'
  git -C \"\$HOME/.dotfiles\" checkout '$setup_ref'
  git -C \"\$HOME/.dotfiles\" pull --ff-only
fi"

remote_args=''
if [ "$with_dotfiles" -eq 1 ]; then
  remote_args='--with-dotfiles'
fi

remote_dotfiles_args=$dotfiles_args

if [ "$install_apt" -eq 0 ]; then
  remote_args="$remote_args --skip-apt"
else
  remote_args="$remote_args --install-apt"
fi

if [ "$install_neovim" -eq 0 ]; then
  remote_args="$remote_args --skip-neovim"
fi

remote_args="$remote_args $remote_dotfiles_args"

ssh "$host" "\"\$HOME/.dotfiles/ubuntu-agent/install.sh\" $remote_args"
